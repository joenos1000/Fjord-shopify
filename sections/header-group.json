{"type":"header","name":"Header","sections":{"custom_liquid_p3Kftx":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n  .age-verification-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0, 0, 0, 0.7);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 9999;\n    opacity: 0;\n    visibility: hidden;\n    pointer-events: none;\n    transition: opacity 0.3s ease, visibility 0.3s ease;\n  }\n\n  .age-verification-overlay.visible {\n    opacity: 1;\n    visibility: visible;\n    pointer-events: auto;\n  }\n\n  .age-verification-modal {\n    background-color: #fdf9f0;\n    border-radius: 2px;\n    padding: 60px 50px;\n    max-width: 500px;\n    width: 90%;\n    text-align: center;\n    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\n    animation: slideUp 0.4s ease-out;\n  }\n\n  @keyframes slideUp {\n    from {\n      opacity: 0;\n      transform: translateY(30px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  .age-verification-logo {\n    margin: 0 auto 40px auto;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n  }\n\n  .age-verification-logo img {\n    max-height: 70px;\n    width: auto;\n    display: block;\n  }\n\n  .age-verification-heading {\n    font-family: 'Bebas Neue', sans-serif;\n    font-size: 48px;\n    font-weight: 400;\n    letter-spacing: 0.05em;\n    color: #000000;\n    margin: 0 0 20px 0;\n    line-height: 1.2;\n  }\n\n  .age-verification-subtext {\n    font-family: serif;\n    font-size: 18px;\n    color: #000000cf;\n    margin: 0 0 50px 0;\n    line-height: 1.6;\n    font-weight: 400;\n  }\n\n  .age-verification-buttons {\n    display: flex;\n    gap: 16px;\n    flex-direction: column;\n  }\n\n  .age-verification-button {\n    padding: 16px 32px;\n    font-size: 18px;\n    font-family: 'Bebas Neue', sans-serif;\n    border: none;\n    border-radius: 14px;\n    cursor: pointer;\n    font-weight: 400;\n    transition: all 0.3s ease;\n    letter-spacing: 0.05em;\n  }\n\n  .age-verification-button-yes {\n    background-color: #000000;\n    color: #ffffff;\n    border: 2px solid #000000;\n  }\n\n  .age-verification-button-yes:hover {\n    background-color: #333333;\n    border-color: #333333;\n  }\n\n  .age-verification-button-no {\n    background-color: transparent;\n    color: #000000;\n    border: 2px solid #000000;\n  }\n\n  .age-verification-button-no:hover {\n    background-color: #fafafa;\n    border-color: #333333;\n    color: #333333;\n  }\n\n  .age-verification-button:active {\n    transform: scale(0.98);\n  }\n\n  body.age-verification-active {\n    overflow: hidden;\n  }\n\n  @media (max-width: 600px) {\n    .age-verification-modal {\n      padding: 40px 30px;\n    }\n\n    .age-verification-logo {\n      margin-bottom: 30px;\n    }\n\n    .age-verification-logo img {\n      max-height: 55px;\n    }\n\n    .age-verification-heading {\n      font-size: 36px;\n    }\n\n    .age-verification-subtext {\n      font-size: 15px;\n      margin-bottom: 40px;\n    }\n\n    .age-verification-button {\n      padding: 14px 24px;\n      font-size: 16px;\n    }\n  }\n<\/style>\n\n<div id=\"ageVerificationOverlay\" class=\"age-verification-overlay\">\n  <div class=\"age-verification-modal\">\n    <div class=\"age-verification-logo\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0808\/2269\/8312\/files\/Fjord-ikon-logo.png?v=1771539157\" alt=\"Fjord Bryggeri og Destilleri\">\n    <\/div>\n    <h1 class=\"age-verification-heading\">Velkommen til Fjord<\/h1>\n    <p class=\"age-verification-subtext\">Bekræft venligst, at du er 18 år eller ældre for at komme ind på denne side.<\/p>\n    <div class=\"age-verification-buttons\">\n      <button id=\"ageVerificationYes\" class=\"age-verification-button age-verification-button-yes\">Ja, jeg er over 18<\/button>\n      <button id=\"ageVerificationNo\" class=\"age-verification-button age-verification-button-no\">Nej<\/button>\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\n  (function() {\n    const VERIFICATION_KEY = 'fjord_age_verified';\n    const VERIFICATION_TIMESTAMP = 'fjord_age_verified_time';\n    const VERIFICATION_DURATION = 30 * 24 * 60 * 60 * 1000;\n\n    function isAgeVerified() {\n      const verified = localStorage.getItem(VERIFICATION_KEY);\n      const timestamp = localStorage.getItem(VERIFICATION_TIMESTAMP);\n\n      if (!verified || !timestamp) return false;\n\n      const now = Date.now();\n      const verifiedTime = parseInt(timestamp, 10);\n\n      if (now - verifiedTime > VERIFICATION_DURATION) {\n        localStorage.removeItem(VERIFICATION_KEY);\n        localStorage.removeItem(VERIFICATION_TIMESTAMP);\n        return false;\n      }\n\n      return verified === 'true';\n    }\n\n    function setAgeVerified() {\n      localStorage.setItem(VERIFICATION_KEY, 'true');\n      localStorage.setItem(VERIFICATION_TIMESTAMP, Date.now().toString());\n    }\n\n    function hideAgeVerification() {\n      const overlay = document.getElementById('ageVerificationOverlay');\n      if (overlay) {\n        overlay.classList.remove('visible');\n        document.body.classList.remove('age-verification-active');\n      }\n    }\n\n    function showAgeVerification() {\n      const overlay = document.getElementById('ageVerificationOverlay');\n      if (overlay) {\n        overlay.classList.add('visible');\n        document.body.classList.add('age-verification-active');\n      }\n    }\n\n    function handleYesClick() {\n      setAgeVerified();\n      hideAgeVerification();\n    }\n\n    function handleNoClick() {\n      window.location.href = 'https:\/\/www.google.dk';\n    }\n\n    function initAgeVerification() {\n      if (!isAgeVerified()) {\n        showAgeVerification();\n\n        const yesButton = document.getElementById('ageVerificationYes');\n        const noButton = document.getElementById('ageVerificationNo');\n\n        if (yesButton) yesButton.addEventListener('click', handleYesClick);\n        if (noButton) noButton.addEventListener('click', handleNoClick);\n      }\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initAgeVerification);\n    } else {\n      initAgeVerification();\n    }\n  })();\n<\/script>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"header_announcements_9jGBFp":{"type":"header-announcements","blocks":{"announcement_BxgCk9":{"type":"_announcement","settings":{"text":"Velkommen til vores nye hjemmeside! Tag et kig rundt, vi findpudser stadig det sidste:)","link":"","font":"var(--font-subheading--family)","font_size":"0.75rem","weight":"","letter_spacing":"normal","case":"none"},"blocks":{}}},"block_order":["announcement_BxgCk9"],"name":"t:names.announcement_bar","settings":{"speed":5,"section_width":"page-width","color_scheme":"scheme-bccb377a-1bce-4f1e-8d76-c48dc5912ccd","divider_width":1,"padding-block-start":15,"padding-block-end":15}},"header_section":{"type":"header","blocks":{"header-logo":{"type":"_header-logo","static":true,"settings":{"hide_logo_on_home_page":false,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"header-menu":{"type":"_header-menu","static":true,"settings":{"menu":"ny-header-menu","color_scheme":"","type_font_primary_size":"0.875rem","menu_font_style":"inverse","type_font_primary_link":"body","type_case_primary_link":"none","menu_style":"featured_products","featured_products_aspect_ratio":"4 \/ 5","featured_collections_aspect_ratio":"16 \/ 9","image_border_radius":0,"navigation_bar":false,"color_scheme_navigation_bar":"","drawer_accordion":false,"drawer_accordion_expand_first":false,"drawer_dividers":false},"blocks":{}}},"settings":{"logo_position":"center","menu_position":"left","menu_row":"top","customer_account_menu":"customer-account-main-m