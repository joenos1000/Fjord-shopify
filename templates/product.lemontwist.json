or-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_Y78dUL":{"type":"text","name":"t:names.heading","settings":{"text":"<p>Skal din gin være frisk, mild og fuld af citrus, så prøv vores Lemon Twist… <\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_EdRG9W":{"type":"text","name":"t:names.text","settings":{"text":"<p>Lemon Twist var den første gin, vi destillerede i kobberkedlen på FJORD, og den bærer stadig sin intermistiske FJORD-etiket med navneskilt om halsen som en påmindelse om dette. Hvor Fjordblik er krydret og kontant, er Lemon Twist lettere til bens – en gin med næsen fuld af citrus og en blid kerne af enebær, der holder sammen på det hele. <\/p><p>Citroner og gin har hørt sammen i århundreder. Allerede i 1700-tallets London blandede man gin med citron for at gøre den mere drikbar – og da den engelske flåde i kolonialismens navn indtog den nye verden, blev Gin & Tonic brugt som medicin: Ginnen løftede humøret, kininen i Tonic modvirkede malaria og med en skive citron var man også fri af skærbug … sagde man. <\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_wNWfqc","text_Y78dUL","text_EdRG9W"],"name":"t:names.rich_text_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":25,"section_width":"page-width","section_height":"small","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":28}},"section_er63c6":{"type":"section","blocks":{"text_BnRJgY":{"type":"text","name":"t:names.heading","settings":{"text":"<p>servering<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_LBezWG":{"type":"text","name":"t:names.text","settings":{"text":"<p>Lemon Twist hylder det årelange bånd mellem gin og citron. Den fungerer lige godt en sommeraften ved fjorden, som den gør indendøre om vinteren. Den er frisk uden at være skinger, mild uden at være ligegyldig. Prøv den i en Gin & Lemon, Gin & Tonic eller Tom Collins. <br\/><br\/><strong>Serveringsforslag<\/strong>: <br\/>Gin & Tonic med frisk citrontimian og et tyndt hjul af citron. Oplagt i en Tom Collins, Gin Hass, Gimlet eller French 75. <br\/><br\/><strong>Ingredienser<\/strong>: <br\/>Enebær, citrusskaller. Destilleret i kobberkedel. <br\/>42% alkohol, 500 ml. <\/p>","width":"fit-c