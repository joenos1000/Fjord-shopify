":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_Y78dUL":{"type":"text","name":"t:names.heading","settings":{"text":"<p>Sort Kuling er for kendere og connaisseurs<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_EdRG9W":{"type":"text","name":"t:names.text","settings":{"text":"<p>som vil have deres øl sort som natten, ligeså svovlende bitter som en arrig skipper i høj sø. <br\/><br\/>Med denne London Porter (som jo oprindelig var en prisvenlig, mørk øl, drukket af engelske havnearbejdere) bevæger vi os fra fjorden og ud på det åbne hav, derude hvor det afgrundsmørke dyb lurer. I glasset er den kulsort med en smuk espressofarvet skum, og fra første tår lades din mund med røg, krudt og tjærebehandlet skibsdæk. <br\/><br\/>Chokolademalt, Black Malt og Crystal Malt skænker Sort Kuling intense noter af mørkristet kaffe, bitter chokolade, lakrids, mens mosaic-humlen her bruges for bitterheden og giver denne kulsorte porter fra havnen i Nykøbing Mors sit markante og robuste bid.  <\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"bl