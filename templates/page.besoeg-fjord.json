okale og de, der passerer forbi. Vi arrangerer både rundvisninger og smagninger, koncerter og events, ligesom du kan booke vores lokaler til både firmaarrangementer og private sammenkomster.<\/p><p>Vi håber, du vil kigge forbi. For god øl og spiritus er ingenting uden godt selskab.<br\/><br\/><strong>Vores åbningstider<\/strong> er i øjeblikket:<\/p><p>Fredag kl. 14–19<br\/>Lørdag kl. 14–19<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"button_WxjqgX":{"type":"button","name":"t:names.button","disabled":true,"settings":{"label":"Køb nu","link":"shopify:\/\/collections\/all","open_in_new_tab":false,"style_class":"button","width":"fit-content","custom_width":100,"width_mobile":"fit-content","custom_width_mobile":100},"blocks":{}}},"block_order":["text_CBfRfi","text_xTYiha","button_WxjqgX"],"name":"t:names.rich_text_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":25,"section_width":"page-width","section_height":"small","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":21,"padding-block-end":48}},"section_qbhDbc":{"type":"section","blocks":{"text_zgiNVB":{"type":"text","name":"t:names.text","se