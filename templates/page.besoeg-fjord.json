0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_aCqEty"]},"accordion_row_eQzJEc":{"type":"_accordion-row","settings":{"heading":"Hvordan kontakter jeg Fjord?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_iEKTYC":{"type":"text","settings":{"text":"<p>Du kan kontakte os via e-mail på info@fjord-bryg.dk, via telefon i vores åbningstider eller gennem dette <a href=\"\/pages\/kontakt\" target=\"_blank\" title=\"Kontakt\"><strong>link<\/strong><\/a>. Du finder vores kontaktoplysninger på kontaktsiden. Vi bestræber os på at besvare alle henvendelser inden for 24 timer på hverdage.<\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"custom","font":"var(--font-body--family)","font_size":"0.875rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_iEKTYC"]},"accordion_row_yPV6np":{"type":"_accordion-row","settings":{"heading":"Sælger I gavekort?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_nTwYUF":{"type":"text","settings":{"text":"<p>Ja, vi tilbyder digitale gavekort, som kan købes direkte på webshoppen. Gavekortet sendes til modtagerens e-mailadresse og kan bruges på alle produkter i vores sortiment.<\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"custom","font":"var(--font-body--family)","font_size":"0.875rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_nTwYUF"]}},"block_order":["accordion_row_KxPbzJ","accordion_row_9jWiEP","accordion_row_NzTjf6","a